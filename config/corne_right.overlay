/*
 * Additions on top of the upstream corne_right shield.
 *
 * SPDX-License-Identifier: MIT
 */

#include "layers.h"
/* zip_* processor labels are /omit-if-no-ref/; nothing in ZMK includes this for us. */
#include <input/processors.dtsi>

&pinctrl {
	i2c1_default: i2c1_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 4)>,
				<NRF_PSEL(TWIM_SCL, 1, 6)>;
		};
	};

	i2c1_sleep: i2c1_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 4)>,
				<NRF_PSEL(TWIM_SCL, 1, 6)>;
			low-power-enable;
		};
	};
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";

	trackball: trackball@a {
		compatible = "pimoroni,pim447";
		reg = <0xa>;
		poll-interval = <20>;

		power-layer = <0>; /* MOUSE layer */
		// idle-timeout = <10>; /* in seconds */
		// invert-move-x;               // Invert mouse X axis (left is right, and vice versa)
		// invert-move-y;               // Invert mouse Y axis (up is down, and vice versa)
		// swap-axes;                   // Swap X and Y axes (horizontal is vertical, and vice versa)
		// invert-scroll-x;             // Invert wheel X axis (left is right, and vice versa)

		move-factor-x = <110>;       // Sensitivity X; default: 100
		move-factor-y = <110>;       // Sensitivity Y; default: 100
		move-inertia-x = <70>;       // Inertia X, between 0 (no inertia) and 99 (huge inertia); default: 0; note that some inertia is needed for acceleration
		move-inertia-y = <70>;       // Inertia Y, between 0 (no inertia) and 99 (huge inertia); default: 0; note that some inertia is needed for acceleration
		norm = <PIM447_NORM_MAX>; // Metric for 2d distance measurement; default: PIM447_NORM_EUCLID; alternative: PIM447_NORM_MAX in order to enhance diagonal movement
		exactness = <5>;             // Range of small velocities that are not accelerated
		max-accel = <130>;           // Maximum acceleration; default: 100
		scroll-divisor-x = <3>;      // Increase wheel velocity (default: 2)
		scroll-divisor-y = <3>;      // Increase wheel velocity (default: 2)
		button = <0>;                // Send mouse button 4 when pressing the ball which is usually ignored by the operating system (default: 0, ie. left-click)
	};
};

/ {
	trackball_listener {
		compatible = "zmk,input-listener";
		device = <&trackball>;
		input-processors = <&zip_xy_scaler 11 10>;

		scroll {
			layers = <SCROLL>;
			input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 3>;
		};
	};
};
